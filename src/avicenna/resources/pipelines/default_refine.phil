refine {
  input {
    output_dir = "."
    dataset_list = "qrefine_list.txt"
    params_file = "qrefine_input_parameters.txt"
    reference_mtz = None
    reference_pdb = None
  }
  output {
    directory = "."
    log_folder = None
  }
  steps {
    step {
      id = 1_rigid_body
      program = phenix.refine
    }
    step {
      id = 2_phaser
      program = phenix.phaser
      phaser {
        mr_cutoff = 0.45
        mr_copies = 1
        mr_mw = 0.0
        mr_seq_id = 90.0
        mr_tncs = False
        monomer = False
        mr_try_monomer = False
        monomer_rfree_cutoff = 0.4
        mr_copies_monomer = 1
        mr_mw_monomer = 0.0
      }
    }
    step {
      id = 3_jelly
      program = refmac5
      refmac {
        ncycles = 4
        jelly = True
        monomer = False
      }
    }
    step {
      id = 4_refmac5
      program = refmac5
      refmac {
        ncycles = 8
        jelly = False
        monomer = False
      }
    }
    step {
      id = 5_phaser_mono
      program = phenix.phaser
      phaser {
        mr_cutoff = 0.45
        mr_copies = 1
        mr_mw = 0.0
        mr_seq_id = 90.0
        mr_tncs = False
        monomer = True
        mr_try_monomer = False
        monomer_rfree_cutoff = 0.4
        mr_copies_monomer = 1
        mr_mw_monomer = 0.0
      }
    }
    step {
      id = 6_jelly_mono
      program = refmac5
      refmac {
        ncycles = 4
        jelly = True
        monomer = True
      }
    }
    step {
      id = 7_refmac5_mono
      program = refmac5
      refmac {
        ncycles = 8
        jelly = False
        monomer = True
      }
    }
    step {
      id = 8_fill
      program = fill
      fill {
        enabled = True
      }
    }
  }
}
