refine {
  input {
    output_dir = "."
    dataset_list = "qrefine_list.txt"
    params_file = "qrefine_input_parameters.txt"
    reference_mtz = None
    reference_pdb = None
  }
  output {
    directory = "."
    log_folder = None
  }
  steps {
    step {
      id = 1_rigid_body
      program = phenix.refine
      phenix {
        strategy = rigid_body
        number_of_macro_cycles = 5
        hydrogens = riding
      }
    }
    step {
      id = 2_phaser
      program = phenix.phaser
      phaser {
        rfree_threshold = 0.45
      }
    }
    step {
      id = 3_jelly
      program = refmac5
      refmac {
        ncycles = 4
        jelly = True
      }
    }
    step {
      id = 4_refmac5
      program = refmac5
      refmac {
        ncycles = 8
        jelly = False
      }
    }
    step {
      id = 5_fill
      program = fill
      fill {
        enabled = True
      }
    }
  }
}
