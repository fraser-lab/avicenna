refine {
  water = hoh
  ncpu = auto
  input {
    output_dir = "."
    dataset_list = None
    reference_mtz = None
    reference_pdb = None
  }
  output {
    directory = "."
    log_folder = None
  }
  programs {
    ccp4 {
      root = None
      version = latest
    }
    phenix {
      root = None
      version = latest
    }
  }
  steps {
    step {
      id = 1_phaser
      program = "phenix.phaser"
      phaser {
        rfree_threshold = 0.45
        tncs = False
        alt_search_model = None
        asu_composition {
          derive_from_pdb = True
          num_copies = 1
          mw = 0.0
          seq_id = 90.0
        }
        extra_args = None
      }
    }
    step {
      id = 2_jelly
      program = refmac5
      refmac {
        ncycles = 4
        jelly = True
      }
    }
    step {
      id = 3_refmac5
      program = refmac5
      refmac {
        ncycles = 8
        jelly = False
      }
    }
    step {
      id = 4_fill
      program = fill
      fill {
        enabled = True
      }
    }
  }
}
